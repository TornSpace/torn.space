{
  "name": "@torn.space/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --outdir=build --target bun --minify",
    "build:db": "NODE_ENV=\"drizzle\" bun build src/drizzle.config.ts src/models/*.ts --outdir=drizzle --target bun --minify",
    "db:generate": "NODE_ENV=\"drizzle\" bun --bun drizzle-kit generate --config drizzle/src/drizzle.config.js",
    "db:push": "NODE_ENV=\"drizzle\" bun --bun drizzle-kit push --config drizzle/src/drizzle.config.js",
    "dev": "bun --watch src/index.ts",
    "start": "NODE_ENV=\"production\" bun build/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "obscenity": "^0.4.6",
    "proxycheck-ts": "^0.0.11",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^0.31.10"
  }
}
