{
  "name": "@torn.space/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --outdir=build --target bun --minify --minify-syntax --minify-whitespace --minify-identifiers",
    "dev": "bun --watch src/index.ts",
    "start": "NODE_ENV=\"production\" bun build/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "obscenity": "^0.4.6",
    "pg": "^8.20.0",
    "proxycheck-ts": "^0.0.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
