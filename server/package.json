{
  "name": "@torn.space/server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --outdir=build --target bun --minify --minify-syntax --minify-whitespace --minify-identifiers",
    "dev": "bun --watch src/index.ts",
    "start": "NODE_ENV=\"production\" bun build/index.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13"
  }
}
