{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "newLine": "lf"
  },
  "exclude": [
    "**/node_modules/**",
    "**/references/**",
    "**/build/**"
  ]
}
